# 生成AIを接続するときに設定する
DATABASE_URL=
# 公開時はSupabaseのSession pooler接続URLを設定する。空欄ならローカルSQLiteを使用。
# 接続URLはサーバーの秘密情報。mobileやGitに書かない。
OPENAI_API_KEY=
# Structured Outputs対応で、契約中のアカウントから利用できるモデルIDを設定する。
OPENAI_MODEL=
# 呼び出し回数の上限。日次・月次はUTC基準。0ならAI呼び出し停止。
# 失敗時も数える。金額そのものの上限ではない。
AI_USER_MINUTE_LIMIT=10
AI_USER_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=100
AI_GLOBAL_MONTHLY_LIMIT=1000
# WebフロントのURLをカンマ区切りで指定する（ネイティブにはCORS制限は適用されない）。
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
