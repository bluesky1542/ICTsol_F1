# 生成AIを接続するときに設定する
DATABASE_URL=
# 公開時はSupabaseのSession pooler接続URLを設定する。空欄ならローカルSQLiteを使用。
# 接続URLはサーバーの秘密情報。mobileやGitに書かない。
OPENAI_API_KEY=
# Structured Outputs対応で、契約中のアカウントから利用できるモデルIDを設定する。
OPENAI_MODEL=
# WebフロントのURLをカンマ区切りで指定する（ネイティブにはCORS制限は適用されない）。
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
